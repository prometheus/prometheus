{
  "name": "prometheus-io",
  "description": "Monorepo for the Prometheus UI",
  "version": "0.314.0",
  "private": true,
  "scripts": {
    "build": "bash build_ui.sh --all",
    "build:mantine-ui": "bash build_ui.sh --mantine-ui",
    "build:module": "bash build_ui.sh --build-module",
    "start": "pnpm --filter @prometheus-io/mantine-ui run start",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint"
  },
  "workspaces": [
    "mantine-ui",
    "module/*"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript/native": "npm:typescript@^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.0"
  }
}
