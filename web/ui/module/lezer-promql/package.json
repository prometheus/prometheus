{
  "name": "@prometheus-io/lezer-promql",
  "version": "0.314.0",
  "description": "lezer-based PromQL grammar",
  "main": "dist/index.cjs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "import": "./dist/esm/client/index.js",
      "require": "./dist/cjs/client/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "client": ["./dist/types/client/index.d.ts"]
    }
  },
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "author": "Prometheus Authors <prometheus-developers@googlegroups.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prometheus/prometheus.git"
  },
  "keywords": [
    "lezer",
    "promql"
  ],
  "bugs": {
    "url": "https://github.com/prometheus/prometheus/issues"
  },
  "homepage": "https://github.com/prometheus/prometheus/blob/main/web/ui/module/lezer-promql/README.md",
  "scripts": {
    "build": "bash ./build.sh",
    "lint": "eslint src/ --ext .ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "lru-cache": "^11.5.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@lezer/generator": "^1.8.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.1.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "rollup": "^4.62.3",
    "tslib": "^2.8.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@lezer/highlight": "^1.1.2",
    "@lezer/lr": "^1.2.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 150
  }
}
