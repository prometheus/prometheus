    series{type="1_dp_after/st_outside_lookback"}@st                  _x100    _    _ -10m    _
    series{type="1_dp_after/st_outside_lookback"}                     _x100    _    _   60    _
    series{type="1_dp_after/st_outside_range"}@st                     _x100    _    _  -5m    _
