    series{type="1_dp_before/st_outside_lookback"}@st                 _x100 -10m    _    _    _
    series{type="1_dp_before/st_outside_lookback"}                    _x100   60    _    _    _
    series{type="1_dp_before/st_outside_range"}@st                    _x100  -3m    _    _    _
